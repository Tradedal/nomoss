{
  "name": "nomoss",
  "description": "Effect-native infrastructure automation for TypeScript.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tradedal/nomoss.git"
  },
  "scripts": {
    "check": "yarn format && yarn lint && yarn typecheck:tsgo && vitest run --pool forks --passWithNoTests --exclude 'tests/**/*.integration.test.ts'",
    "format": "biome check --write",
    "format:staged": "biome check --write --staged --no-errors-on-unmatched",
    "generate:aws-resource-definition": "tsx tools/compileAwsResourceDefinition.ts",
    "generate:aws-resources": "tsx tools/compileAwsCloudControlClient.ts",
    "generate:stripe-client": "tsx tools/compileStripeClient.ts",
    "lint": "biome lint --reporter=summary",
    "lint:fix": "biome check --write",
    "nomoss": "tsx examples/cli.ts",
    "tsgo:patch": "effect-tsgo patch --typescript",
    "typecheck:tsgo": "yarn format:staged && effect-tsgo tsc --build .",
    "test:integration": "vitest run --config vitest.integration.config.ts --pool forks",
    "test:integration:aws": "vitest run --config vitest.integration.config.ts tests/awsUploadEvents.integration.test.ts --pool forks",
    "test:integration:stripe": "vitest run --config vitest.integration.config.ts tests/stripe --pool forks",
    "projen": "tsx .projenrc.ts",
    "postinstall": "yarn tsgo:patch"
  },
  "devDependencies": {
    "@aws-cdk/service-spec-importers": "0.0.145",
    "@aws-cdk/service-spec-types": "0.0.289",
    "@biomejs/biome": "2.6.6",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.4",
    "@tradedal/linteffect": "0.1.1-dev.3",
    "@types/node": "^24.0.0",
    "commit-and-tag-version": "^12",
    "constructs": "^10.0.0",
    "projen": "^0.98.34",
    "ts-morph": "27.0.2",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@6.0.2",
    "vite": "^8.0.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/core": "^3.979.1",
    "@aws-sdk/credential-provider-node": "^3.972.92",
    "@effect/platform-node": "4.1.4",
    "@smithy/core": "^3.38.1",
    "@smithy/signature-v4": "^5.7.5",
    "@smithy/types": "^4.19.0",
    "effect": "4.1.4",
    "esbuild": "^0.27.0",
    "fflate": "^0.8.3",
    "redis": "^6.3.1",
    "tsx": "^4.20.6",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.3",
  "packageManager": "yarn@4.17.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./cli": "./src/cli.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/commands": "./src/providers/resourceCommandPolicyLayer.ts",
    "./providers/runtime": "./src/providers/providerRuntimeLayer.ts",
    "./providers/aws": "./src/providers/aws/runtime.ts",
    "./providers/aws/client": "./src/providers/aws/client/awsClient.ts",
    "./providers/aws/client/config": "./src/providers/aws/client/awsClientConfig.ts",
    "./providers/aws/client/model": "./src/providers/aws/client/awsClientModel.ts",
    "./providers/aws/client/signer": "./src/providers/aws/client/awsRequestSigner.ts",
    "./providers/aws/client/decoder": "./src/providers/aws/client/awsResponseDecoder.ts",
    "./providers/aws/client/retry": "./src/providers/aws/client/awsRetryPolicy.ts",
    "./providers/aws/client/cloud-control": "./src/providers/aws/client/generated/cloudControl.ts",
    "./providers/aws/client/*": "./src/providers/aws/client/generated/*.ts",
    "./providers/aws/management": "./src/providers/aws/management/resourcePolicy.ts",
    "./providers/aws/management/mapping": "./src/providers/aws/management/resourceMapping.ts",
    "./providers/aws/management/configuration": "./src/providers/aws/management/resourceConfiguration.ts",
    "./providers/aws/iam/grant": "./src/providers/aws/resources/iam/grant.ts",
    "./providers/aws/iam/role": "./src/providers/aws/resources/iam/roleDeclaration.ts",
    "./providers/aws/lambda/function": "./src/providers/aws/resources/lambda/functionDeclaration.ts",
    "./providers/aws/cloud-control": "./src/providers/aws/cloudControl/runtime.ts",
    "./providers/aws/cloud-control/client": "./src/providers/aws/cloudControl/client.ts",
    "./providers/aws/cloud-control/lifecycle": "./src/providers/aws/cloudControl/resourceLifecycle.ts",
    "./providers/aws/cloud-control/requests": "./src/providers/aws/cloudControl/requestTracker.ts",
    "./providers/aws/cloud-control/commands": "./src/providers/aws/cloudControl/resourceCommandPolicyLayer.ts",
    "./providers/aws/cloud-control/*": "./src/providers/aws/cloudControl/resources/generated/*/index.ts",
    "./providers/aws/*": "./src/providers/aws/resources/generated/native/*/index.ts",
    "./providers/stripe": "./src/providers/stripe/index.ts"
  },
  "files": [
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "docs",
    "examples",
    "media",
    "src"
  ],
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
