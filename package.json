{
  "name": "nomoss",
  "description": "Effect-native infrastructure automation for TypeScript.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tradedal/nomoss.git"
  },
  "scripts": {
    "check": "yarn format && yarn lint && yarn typecheck:tsgo && vitest run --pool forks --passWithNoTests --exclude 'tests/**/*.integration.test.ts'",
    "format": "biome check --write",
    "format:staged": "biome check --write --staged --no-errors-on-unmatched",
    "generate:aws-resources": "tsx tools/compileAwsServiceResourceDeclarations.ts && yarn generate:aws-management",
    "generate:aws-management": "tsx tools/compileAwsManagementRegistry.ts",
    "generate:aws-credential-clients": "tsx tools/compileAwsCredentialClients.ts",
    "generate:stripe-client": "tsx tools/compileStripeClient.ts",
    "lint": "biome lint --reporter=summary",
    "lint:fix": "biome check --write",
    "nomoss": "tsx examples/cli.ts",
    "tsgo:patch": "effect-tsgo patch --typescript",
    "typecheck:tsgo": "yarn format:staged && yarn tsgo:patch && effect-tsgo tsc --build .",
    "test:integration": "vitest run --config vitest.integration.config.ts --pool forks",
    "test:integration:stripe": "vitest run --config vitest.integration.config.ts tests/stripe --pool forks",
    "projen": "tsx .projenrc.ts"
  },
  "devDependencies": {
    "@aws-cdk/service-spec-importers": "0.0.145",
    "@aws-cdk/service-spec-types": "0.0.289",
    "@biomejs/biome": "2.6.9",
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "4.1.4",
    "@tradedal/aws-client-cloudcontrol": "workspace:^",
    "@tradedal/aws-client-sqs": "workspace:^",
    "@tradedal/linteffect": "0.1.2-dev",
    "@types/node": "^24.0.0",
    "commit-and-tag-version": "^12",
    "constructs": "^10.0.0",
    "projen": "^0.98.34",
    "ts-morph": "27.0.2",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@6.0.2",
    "vite": "^8.0.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@tradedal/aws-client-core": "workspace:^",
    "@tradedal/aws-client-iam": "workspace:^",
    "@tradedal/aws-client-sts": "workspace:^",
    "@tradedal/aws-credentials": "workspace:^",
    "effect": "4.1.4",
    "esbuild": "^0.27.0",
    "fflate": "^0.8.3",
    "redis": "^6.3.1",
    "tsx": "^4.20.6",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.5",
  "packageManager": "yarn@4.17.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./cli": "./src/cli.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/commands": "./src/providers/resourceCommandPolicyLayer.ts",
    "./providers/runtime": "./src/providers/providerRuntimeLayer.ts",
    "./providers/aws": "./providers/aws/runtime.ts",
    "./providers/aws/management/configuration": "./providers/aws/management/resourceConfiguration.ts",
    "./providers/aws/*.commands": null,
    "./providers/aws/*/commands": null,
    "./providers/aws/resourceCommands": null,
    "./providers/aws/*": "./providers/aws/generated/resources/*.ts",
    "./providers/stripe": "./src/providers/stripe/index.ts"
  },
  "workspaces": [
    "providers/aws/generated/clients/*",
    "providers/aws/client-core",
    "providers/aws/credentials"
  ],
  "files": [
    "/README.md",
    "/ROADMAP.md",
    "/LICENSE",
    "/docs/**",
    "/examples/**",
    "/media/**",
    "/src/**",
    "/providers/aws/README.md",
    "/providers/aws/awsEnvironment.ts",
    "/providers/aws/runtime.ts",
    "/providers/aws/management/**/*.ts",
    "/providers/aws/generated/managementRegistry.ts",
    "/providers/aws/generated/resources/**/*.ts"
  ],
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
