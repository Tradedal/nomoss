{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["@tradedal/linteffect"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      ".projenrc.ts",
      "examples/**/*.ts",
      "src/**/*.ts",
      "tests/**/*.ts",
      "tools/**/*.ts",
      "vitest.config.ts",
      "vitest.integration.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
